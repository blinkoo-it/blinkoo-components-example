{
  "name": "nextjs-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "copyBlinkooAssets": "rm -r public/blinkoo-assets 2> /dev/null && cp -r node_modules/@blinkoo/components/assets public/blinkoo-assets",
    "dev": "npm run copyBlinkooAssets && next dev",
    "build": "npm run copyBlinkooAssets && next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@blinkoo/components": "2.0.0-beta.21",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.15",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
